+}
+
+const AERA_GATEWAY_CONNECTION = "relay-messages-dogfood-canonical-connection";
+const AERA_GATEWAY_RUNTIME = "relay-messages-dogfood-canonical-runtime";
+const readySessions = new Map();
+
+function governedAeraGatewayProfile(profile) {
+	try {
+		const base = new URL(profile?.baseURL);
+		return (base.hostname === "127.0.0.1" || base.hostname === "localhost")
+			&& base.pathname.replace(/\/$/, "") === "/v1"
+			&& profile?.headers?.["x-aera-connection-id"] === AERA_GATEWAY_CONNECTION
+			&& profile?.headers?.["x-aera-runtime-instance-id"] === AERA_GATEWAY_RUNTIME;
+	} catch {
