+/**
+ * One local terminal owner per translated demand. The existing watchdog owns
+ * the idle timer; wire keepalives cannot rearm it here. Settling only releases
+ * this caller: neither abort nor detached return proves remote termination.
+ */
+export function settleStreamDemand(watchdog, iterator) {
+	return new Promise((resolve) => {
+		const signal = watchdog.signal;
+		let settled = false;
+		const settle = (outcome) => {
+			if (settled) return;
+			settled = true;
+			signal.removeEventListener("abort", onAbort);
+			resolve(outcome);
+		};
+		const onAbort = () => settle({ kind: "abort", reason: signal.reason });
+		signal.addEventListener("abort", onAbort, { once: true });
+		if (signal.aborted) {
+			onAbort();
+			return;
+		}
+		try {
+			Promise.resolve(watchdog.next(iterator)).then(
+				(result) => settle({ kind: "result", result }),
+				(error) => settle({ kind: "error", error })
+			);
+		} catch (error) {
+			settle({ kind: "error", error });
+		}
+	});
+}
+
+/**
+ * Translator return can queue behind its ignored next, or await SDK teardown.
+ * Observe rejection without awaiting either. Diagnostic state is DETACHED,
+ * remote transport state UNKNOWN, even if return subsequently resolves.
+ * An abandoned source promise may remain pending; this is not leak elimination.
+ */
+export function detachStreamReturn(iterator) {
+	try {
+		Promise.resolve(iterator.return(void 0)).catch(() => {});
+	} catch (_synchronousTeardownError) {}
+}
