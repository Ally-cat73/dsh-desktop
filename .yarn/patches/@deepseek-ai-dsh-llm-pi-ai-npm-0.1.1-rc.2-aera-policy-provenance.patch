+	const normalized = String(sessionId).trim();
+	if (!SESSION_ID_PATTERN.test(normalized)) throw new Error("AERA_CODE_SESSION_ID_INVALID");
+	return {
+		...retained,
+		[SESSION_HEADER]: normalized,
+		[CLIENT_REQUEST_HEADER]: normalized
