+/**
+* AERA WO-AGC-004 remit AC2 (owner ruling §10-§12) — TOOL-SPILL METADATA BOUNDARY.
+*
+* Framework-generated spill bookkeeping is no longer flattened into the model-
+* facing SEMANTIC result text. The search tools own the spill they created, so
+* they retain its reference HERE, in a process-local registry outside the
+* semantic text, and the model-facing footer states only the bounded truth
+* (how many results were shown, and that the complete result was retained).
+*
+* Why: the local spill backend's locator is an absolute path whose four
+* randomised segments (the per-user temp directory, the `dsh-spill-` suffix,
+* the session-hash directory and the random filename prefix) form a single
+* ~130-character high-entropy span. Composed into UNTRUSTED_TOOL_OUTPUT, that
+* span is exactly the shape the provider-side secret/entropy detectors exist
+* to catch, and it refused a genuine, secret-free `glob` result. The detector
+* was right about the bytes it was shown; the COMPOSITION was wrong.
+*
+* TRUST BOUNDARY (owner §12): a reference exists only because this module
+* called `ctx.spillStore.saveText` and received a real `SpillRef`. Nothing a
+* model, a user or a tool payload can say reaches this registry, and no text
+* anywhere is treated as spill metadata — the semantic result stays governed
+* exactly as before, in full.
+*
+* NOT changed by this repair: which files are shown, the genuine result
+* content, any detector, any threshold, any policy.
+*/
+let spillReferenceSequence = 0;
+const spillReferencesByHandle = new Map();
+/**
+* Record one saved spill reference against the call that produced it and mint
+* its opaque, low-entropy runtime handle.
+*
+* @param exec - the tool-execution context that created the spill.
+* @param ref - the backend `SpillRef`, or `undefined` when nothing was saved.
+* @returns the retained reference record, or `undefined` when nothing was saved.
+*/
+function recordSpillReference(exec, ref) {
+	if (ref === void 0) return;
+	spillReferenceSequence += 1;
+	const record = Object.freeze({
+		handle: `spill-ref-${spillReferenceSequence}`,
+		tool: exec.name,
+		callId: exec.callId,
+		sessionId: exec.agent?.session.header.id,
+		locator: ref.locator,
+		bytes: ref.bytes,
+		retrievalHint: ref.retrievalHint
+	});
+	spillReferencesByHandle.set(record.handle, record);
+	return record;
+}
+/**
+* Resolve a runtime spill handle minted by {@link recordSpillReference}.
+*
+* @param handle - the opaque handle (`spill-ref-<n>`).
+* @returns the retained reference record, or `undefined` when unknown.
+*/
+function spillReferenceByHandle(handle) {
+	return spillReferencesByHandle.get(handle);
+}
+/**
+* Every spill reference this process retained for one model-issued call.
+*
+* @param callId - the model-issued call id.
+* @returns the retained reference records, in mint order.
+*/
+function spillReferencesForCall(callId) {
+	const found = [];
+	for (const record of spillReferencesByHandle.values()) if (record.callId === callId) found.push(record);
+	return found;
+}
