+	}
+}
+
+/** Prove current authority and bootstrap the native Session before Provider dispatch. */
+export function ensureAeraGatewaySessionReady(profile, sessionId, apiKey, fetchImpl = fetch) {
+	if (!governedAeraGatewayProfile(profile)) return Promise.resolve();
+	if (sessionId === void 0 || sessionId === null) {
+		return Promise.reject(new Error("AERA_GATEWAY_PREFLIGHT_SESSION_REQUIRED"));
+	}
+	const normalized = String(sessionId).trim();
+	if (!SESSION_ID_PATTERN.test(normalized)) {
+		return Promise.reject(new Error("AERA_CODE_SESSION_ID_INVALID"));
+	}
+	const current = readySessions.get(normalized);
+	if (current) return current;
+	const origin = new URL(profile.baseURL).origin;
+	const operation = fetchImpl(`${origin}/v1/provider-execution/preflight`, {
+		method: "POST",
+		headers: {
+			authorization: `Bearer ${apiKey}`,
+			"content-type": "application/json",
+			session_id: normalized,
+			"x-client-request-id": normalized,
+			"x-aera-connection-id": AERA_GATEWAY_CONNECTION,
+			"x-aera-runtime-instance-id": AERA_GATEWAY_RUNTIME
+		},
+		body: "{}"
+	}).then(async (response) => {
+		const payload = await response.json().catch(() => null);
+		if (!response.ok) {
+			const code = typeof payload?.error?.code === "string" ? payload.error.code : `HTTP_${response.status}`;
+			throw new Error(`AERA_GATEWAY_PREFLIGHT_DENIED:${code}`);
+		}
+		if (payload?.status !== "ok" || payload.provider_effect !== "NONE"
+			|| payload.current_authority !== "PASS" || payload.route_assignment !== "VALID"
+			|| payload.policy_enforcement_mode !== "OBSERVATION") {
+			throw new Error("AERA_GATEWAY_PREFLIGHT_RESPONSE_INVALID");
+		}
+	});
+	readySessions.set(normalized, operation);
+	operation.catch(() => { readySessions.delete(normalized); });
+	return operation;
+}
