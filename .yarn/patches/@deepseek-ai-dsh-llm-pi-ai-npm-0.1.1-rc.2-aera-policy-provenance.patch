+import { createHash } from "node:crypto";
+
+const HEADER = "x-aera-policy-provenance-v1";
+const SESSION_HEADER = "session_id";
+const CLIENT_REQUEST_HEADER = "x-client-request-id";
+const SESSION_ID_PATTERN = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/;
+
+function textOf(message) {
+	if (!Array.isArray(message?.content)) return "";
+	return message.content
+		.filter((block) => block?.type === "text" && typeof block.text === "string")
+		.map((block) => block.text)
+		.join("");
+}
+
+function identityOf(message, isCurrentUser) {
+	const kind = message?.source?.kind;
+	if (kind === "user") return {
+		source_type: "HUMAN_USER",
+		trust_class: "UNTRUSTED",
+		semantic_role: "USER_INTENT",
+		temporal_role: isCurrentUser ? "CURRENT_USER_TURN" : "CONVERSATION_HISTORY"
+	};
+	if (kind === "skill-catalog") return {
+		source_type: "RUNTIME_SKILL_CATALOGUE",
+		trust_class: "RUNTIME_SUPPLIED",
+		semantic_role: "CONTEXT_INTEGRITY",
+		temporal_role: "RUNTIME_CONTEXT"
+	};
+	if (message?.role === "system" || kind === "plugin") return {
+		source_type: "RUNTIME_PLUGIN_CONTEXT",
+		trust_class: "RUNTIME_SUPPLIED",
+		semantic_role: "CONTEXT_INTEGRITY",
+		temporal_role: "RUNTIME_CONTEXT",
+		...(kind === "plugin" && message?.source?.plugin === "dsh-session-title-llm"
+			? { native_turn_correlation: true }
+			: {})
+	};
+	return null;
+}
+
+/**
+ * Content-free projection of immutable Harness message provenance. Router
+ * validates each digest against the received wire body before using it.
+ */
+export function aeraPolicyProvenanceHeader(messages) {
+	if (!Array.isArray(messages)) return void 0;
+	let currentUserIndex = -1;
+	for (let index = messages.length - 1; index >= 0; index--) {
+		if (messages[index]?.source?.kind === "user") {
+			currentUserIndex = index;
+			break;
+		}
+	}
+	const segments = [];
+	for (const [retainedOrdinal, message] of messages.entries()) {
+		const identity = identityOf(message, retainedOrdinal === currentUserIndex);
+		const content = textOf(message);
+		if (identity === null || content.length === 0) continue;
+		if (typeof message.id !== "string" || !/^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/.test(message.id)) continue;
+		segments.push({
+			correlation_id: message.id,
+			...identity,
+			retained_ordinal: retainedOrdinal,
+			content_sha256: createHash("sha256").update(content, "utf8").digest("hex")
+		});
+	}
+	return segments.length === 0 ? void 0 : JSON.stringify({ version: 1, segments });
+}
+
+/** Merge private policy evidence while rejecting profile-level collisions. */
+export function withAeraPolicyProvenance(headers, messages) {
+	const provenance = aeraPolicyProvenanceHeader(messages);
+	const retained = Object.fromEntries(Object.entries(headers ?? {}).filter(
+		([name]) => name.toLowerCase() !== HEADER
+	));
+	return provenance === void 0 ? retained : { ...retained, [HEADER]: provenance };
+}
+
+/**
+ * Carry the live Aera Code Session on every request. Deployment/profile
+ * headers are deliberately unable to replace this runtime-owned identity.
+ */
+export function withAeraExecutionSession(headers, sessionId) {
+	const reserved = new Set([SESSION_HEADER, CLIENT_REQUEST_HEADER]);
+	const retained = Object.fromEntries(Object.entries(headers ?? {}).filter(
+		([name]) => !reserved.has(name.toLowerCase())
+	));
+	if (sessionId === void 0 || sessionId === null) return retained;
+	const normalized = String(sessionId).trim();
+	if (!SESSION_ID_PATTERN.test(normalized)) throw new Error("AERA_CODE_SESSION_ID_INVALID");
+	return {
+		...retained,
+		[SESSION_HEADER]: normalized,
+		[CLIENT_REQUEST_HEADER]: normalized
+	};
+}
